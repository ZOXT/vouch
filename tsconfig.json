{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true
  },

  "include": [
    "src/**/*",
    "src/prisma.config.ts"
  ]
}