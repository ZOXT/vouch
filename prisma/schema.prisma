generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique @db.Citext
  password_hash       String
  role                Role
  company_name        String?
  avatar_url          String?
  slug                String               @unique
  is_verified         Boolean              @default(false)
  verified_at         DateTime?
  deleted_at          DateTime?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  
  subscription        Subscription?
  testimonials        Testimonial[]
  testimonialRequests TestimonialRequest[]
  embedSections       EmbedSection[]
  campaigns           Campaign[]
  refreshTokens       RefreshToken[]
}

model TestimonialRequest {
  id                         String        @id @default(uuid())
  user_id                    String
  client_name                String
  client_email               String?
  token                      String        @unique
  upload_key                 String?
  status                     RequestStatus @default(pending)
  expires_at                 DateTime
  completed_at               DateTime?
  presigned_url_generated_at DateTime?
  title                      String?
  message                    String?
  questions                  Json?
  created_at                 DateTime      @default(now())
  updated_at                 DateTime      @updatedAt
  
  testimonial                Testimonial?
  user                       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

model Testimonial {
  id                      String                 @id @default(uuid())
  user_id                 String
  request_id              String?                @unique
  client_name             String
  client_email            String?
  video_key               String?
  audio_key               String?
  thumbnail_key           String?
  mime_type               String?
  file_size_bytes         BigInt?
  duration_seconds        Int?
  transcript              String?
  transcript_redacted     String?
  captions_key            String?
  client_designation      String?
  industry                String?
  sentiment               Sentiment?
  pain_points             String[]
  outcomes                String[]
  objections              String[]
  metadata                Json?
  pii_detected            Boolean                @default(false)
  pii_risk_score          Float?
  risk_level              RiskLevel?
  risk_score              Float?
  failure_reason          String?
  status                  TestimonialStatus      @default(pending)
  processed_at            DateTime?
  is_published            Boolean                @default(false)
  published_at            DateTime?
  deleted_at              DateTime?
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  embedding               Unsupported("vector")?
  confidence_score        Float?
  customer_type           String?
  keywords                String[]
  language                String?
  summary                 String?
  processing_completed_at DateTime?
  processing_started_at   DateTime?
  total_processing_ms     Int?
  
  ai_usage                AIUsage[]
  request                 TestimonialRequest?    @relation(fields: [request_id], references: [id])
  user                    User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  campaign                Campaign?              @relation(fields: [campaign_id], references: [id])
  embedSections           EmbedSectionTestimonial[]
  campaign_id             String?

  @@index([user_id])
  @@index([status])
  @@index([industry])
  @@index([user_id, status])
}

model Subscription {
    id                 String    @id @default(uuid())
    user_id            String    @unique
    provider           String    @default("paddle")
    customer_id        String?
    subscription_id    String?   @unique
    plan               String    @default("free")
    status             String    @default("active")
    current_period_end DateTime?
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt

    user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  }

model AIUsage {
  id                String      @id @default(uuid())
  testimonial_id    String
  provider          String
  model             String
  prompt_tokens     Int?
  completion_tokens Int?
  total_tokens      Int?
  latency_ms        Int?
  created_at        DateTime    @default(now())
  error_message     String?
  operation         String      @default("analysis")
  success           Boolean     @default(true)
  
  testimonial       Testimonial @relation(fields: [testimonial_id], references: [id], onDelete: Cascade)

  @@index([testimonial_id])
  @@index([provider])
  @@index([model])
  @@index([operation])
}

model FailedJob {
  id             String          @id @default(uuid())
  queue_name     String
  job_id         String?
  testimonial_id String?
  error_message  String
  error_stack    String?
  category       FailureCategory @default(unknown)
  attempts       Int
  payload        Json
  status         FailedJobStatus @default(pending)
  resolved_at    DateTime?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  job_name       String?

  @@index([status])
  @@index([queue_name])
  @@index([testimonial_id])
}

model EmbedSection {
  id               String   @id @default(uuid())
  user_id          String
  title            String?
  public_id        String   @unique
  layout           String   @default("grid")
  theme            String   @default("minimal")
  is_active        Boolean  @default(true)
  captions_enabled Boolean  @default(true)
  allowed_domains  String[]
  view_count       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user             User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  testimonials     EmbedSectionTestimonial[]

  @@index([user_id])
  @@index([public_id])
}

model EmbedSectionTestimonial {
  embed_section_id String
  testimonial_id   String
  position         Int @default(0)

  embedSection EmbedSection @relation(fields: [embed_section_id],references: [id], onDelete: Cascade)
  testimonial Testimonial @relation(fields: [testimonial_id], references: [id], onDelete: Cascade)

  @@id([embed_section_id, testimonial_id])
  @@index([testimonial_id])
}

model Campaign {
  id               String   @id @default(uuid())
  user_id          String
  title            String
  slug             String   @unique
  description      String?
  questions        Json?
  is_active        Boolean  @default(true)
  allow_video      Boolean  @default(true)
  allow_text       Boolean  @default(false)
  max_duration     Int      @default(120)
  view_count       Int      @default(0)
  submission_count Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  testimonials Testimonial[]

  @@index([user_id])
  @@index([slug])
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

enum Role {
  freelancer
  agency
}

enum TestimonialStatus {
  pending
  media_processing
  transcribing
  ai_processing
  completed
  failed
}

enum RiskLevel {
  low
  medium
  high
}

enum Sentiment {
  positive
  neutral
  negative
  mixed
}

enum RequestStatus {
  pending
  completed
  expired
}

enum FailedJobStatus {
  pending
  retrying
  resolved
  ignored
}

enum FailureCategory {
  groq_timeout
  groq_rate_limit
  invalid_response
  database_error
  media_processing
  unknown
}
