# Postgres (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres
PORT=3000
# Public origin of the API/embed host (used by the embed loader)
APP_URL=http://localhost:5173
# Public origin of the dashboard frontend (used in auth emails, share links)
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API with cookies.
# Single-domain (Caddy) deployments can keep this empty/absent.
# CLIENT_ORIGIN=https://app.tryvouch.me
# Cookie SameSite policy: lax + Secure in production behind Caddy (same
# origin browser<->API), none + Secure only if the SPA and API are cross-origin.
COOKIE_SAME_SITE=lax
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
DUMMY_PASSWORD_HASH=

# AWS S3 (media storage) — IAM role recommended in production
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
# Only needed in development — production uses IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# Groq (AI analysis + transcription)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# Python embedding microservice
EMBEDDING_SERVICE_URL=http://localhost:8000

# Resend (email)
RESEND_API_KEY=
FROM_EMAIL="Vouch <noreply@tryvouch.me>"
REPLY_TO_EMAIL="Vouch <hello@tryvouch.me>"

# Paddle billing — PADDLE_ENV is required; start with sandbox, switch to
# production only when the catalog + webhook are ready.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Live webhook signing secret (Developer tools > Webhooks > endpoint secret)
PADDLE_WEBHOOK_SECRET=
# Live/sandbox price IDs for the single Pro plan (monthly + yearly)
PADDLE_MONTH_PRICE_ID=
PADDLE_YEAR_PRICE_ID=

# Optional tuning
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm
MAX_FILE_SIZE_MB=100
PRESIGNED_URL_EXPIRY=900
ALLOWED_AVATAR_TYPES=image/jpeg,image/png,image/webp
MAX_AVATAR_SIZE_MB=5