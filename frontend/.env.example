# Origin of the backend, used for absolute links to backend-served assets
# (embed iframes/snippets) and as the Vite proxy target in development.
# API calls themselves use the relative /api/v1 path so cookies stay
# same-origin (no CORS). Leave empty in production (same domain).
VITE_API_ORIGIN=http://localhost:3000

# Override the API base path only if you know what you're doing.
# VITE_API_BASE=/api/v1

# Paddle client setup: environment + public client token used to power the
# pricing page (PricePreview) and the overlay checkout. Required or /pricing
# fails loudly instead of rendering a broken checkout.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
