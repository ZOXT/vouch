{
  "name": "vouch",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "worker": "tsx --env-file=.env src/workers/transcription.worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:media": "tsx --env-file=.env src/workers/media.worker.ts",
    "worker:transcription": "tsx --env-file=.env src/workers/transcription.worker.ts",
    "worker:ai": "tsx --env-file=.env src/workers/ai.worker.ts",
    "worker:embedding": "tsx --env-file=.env src/workers/embedding.worker.ts",
    "dlq:retry": "tsx --env-file=.env src/scripts/dlq-retry.ts",
    "dlq:inspect": "tsx --env-file=.env src/scripts/dlq-inspect.ts",
    "workers": "concurrently \"npm run worker:media\" \"npm run worker:transcription\" \"npm run worker:ai\" \"npm run worker:embedding\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@smithy/node-http-handler": "^4.9.7",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^1.4.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4"
  }
}
