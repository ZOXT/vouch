# ---------------------------------------------------------------------------
# Caddy routes for Vouch. Auto-provisions Let's Encrypt certs on first boot
# (requires the A records to resolve to this instance's public IP).
#
# Top-level matcher syntax: `/pattern*` = exact + subtree at path prefix.
# ---------------------------------------------------------------------------

app.tryvouch.me {
    # API + media + embed endpoints -> backend container
    handle /api/* {
        reverse_proxy api:3000
    }
    handle /health {
        reverse_proxy api:3000
    }
    handle /embed.js {
        reverse_proxy api:3000
    }
    handle /embed/* {
        reverse_proxy api:3000
    }

    # Everything else -> SPA
    handle {
        reverse_proxy frontend:80
    }

    encode gzip
}

# Pure API origin: same backend, handy as the embed loader base (APP_URL)
# and for tooling that calls the API directly.
api.tryvouch.me {
    reverse_proxy api:3000
    encode gzip
}

# Marketing apex: public pages only. Anything that isn't a marketing path is
# server-side redirected (302) to the canonical app subdomain, so the apex
# never serves dashboard/auth HTML (no soft-200s, SEO-safe, works without JS).
# 302 (not 301) so a later apex path (e.g. /blog) isn't poisoned by a
# browser/permanent cache; the client-side guard in the SPA handles routes
# that change via router navigation without a page load.
tryvouch.me {
    # API + media + embed endpoints -> backend container
    handle /api/* {
        reverse_proxy api:3000
    }
    handle /health {
        reverse_proxy api:3000
    }
    handle /embed.js {
        reverse_proxy api:3000
    }
    handle /embed/* {
        reverse_proxy api:3000
    }

    # Hashed SPA assets must stay on the apex (same bundle serves the landing).
    handle /assets/* {
        reverse_proxy frontend:80
    }

    # Public marketing pages -> SPA (landing root, pricing, privacy, terms).
    # `path` matches are exact; list trailing-slash variants explicitly.
    @marketing path / /pricing /privacy /terms /refunds /favicon.svg /og-image.png /pricing/ /privacy/ /terms/ /refunds/ /index.html
    handle @marketing {
        reverse_proxy frontend:80
    }

    # Everything else -> canonical app host.
    handle {
        redir https://app.tryvouch.me{uri} temporary
    }

    encode gzip
}

# Canonicalize www -> apex.
www.tryvouch.me {
    redir https://tryvouch.me{uri} permanent
}